{
  "name": "multi-server",
  "version": "2.0.0",
  "description": "Multi-app API server for PTIT HCM students (NestJS refactor)",
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dist-paths.js",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & (while sleep 1; do node scripts/fix-dist-paths.js >/dev/null; done) & node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & (while sleep 1; do node scripts/fix-dist-paths.js >/dev/null; done) & node --watch dist/main.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "mysql2": "^3.24.6",
    "prisma": "^6.0.0",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
