{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@app-type": [
        "./src/app-type"
      ],
      "@app-common": [
        "./src/common"
      ],
      "@app-contracts": [
        "./src/contracts"
      ],
      "@app-jobs": [
        "./src/jobs"
      ],
      "@app-infra/*": [
        "./src/infrastructure/*"
      ],
      "@app-application/*": [
        "./src/application/*"
      ],
      "@app-presentation/*": [
        "./src/presentation/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "legacy"
  ]
}
